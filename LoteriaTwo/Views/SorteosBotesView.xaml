<UserControl x:Class="LoteriaTwo.Views.SorteosBotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ PANEL IZQUIERDO: LOGOS + BOTES ═══════════════════ -->
            <StackPanel Grid.Column="0" Width="281" Margin="0,0,5,0">

                <!-- LOGOS -->
                <GroupBox Header="LOGOS" Margin="0,0,0,5">
                    <StackPanel Margin="5">
                        <ComboBox x:Name="CmbLogos" Margin="0,0,0,8" SelectedIndex="0">
                            <ComboBoxItem Content=""                          Tag=""/>
                            <ComboBoxItem Content="Bonoloto"                  Tag="Bonoloto"/>
                            <ComboBoxItem Content="Primitiva"                 Tag="Primitiva"/>
                            <ComboBoxItem Content="El Gordo de la Primitiva"  Tag="El Gordo"/>
                            <ComboBoxItem Content="Euromillones"              Tag="Euromillones"/>
                            <ComboBoxItem Content="El Millón (Euromillones)"  Tag="EuromillonesMillon"/>
                            <ComboBoxItem Content="Eurodreams"                Tag="Eurodreams"/>
                            <ComboBoxItem Content="Lototurf"                  Tag="LotoTurf"/>
                            <ComboBoxItem Content="Quiniela"                  Tag="Quiniela"/>
                            <ComboBoxItem Content="Quinigol"                  Tag="Quinigol"/>
                            <ComboBoxItem Content="Lotería Nacional"          Tag="LoteriaNacional"/>
                            <ComboBoxItem Content="Apuesta Hípica"            Tag="ApuestaHipica"/>
                            <ComboBoxItem Content="Joker"                     Tag="Joker"/>
                            <ComboBoxItem Content="El Millón"                 Tag="ElMillon"/>
                            <ComboBoxItem Content="Deporte"                   Tag="Deporte"/>
                            <ComboBoxItem Content="Cultura"                   Tag="Cultura"/>
                            <ComboBoxItem Content="Sociedad"                  Tag="Sociedad"/>
                            <ComboBoxItem Content="Genérico LAE"              Tag="GenericoLAE"/>
                            <ComboBoxItem Content="Prog. La Suerte"           Tag="ProgLaSuerte"/>
                            <ComboBoxItem Content="Elige 8"                   Tag="Elige8"/>
                        </ComboBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button Content="ENTRA"    Style="{StaticResource BtnEntra}"
                                    Grid.Row="0" Grid.Column="0" Margin="0,0,3,3"
                                    Click="LogoEntra_Click"/>
                            <Button Content="SALE"     Style="{StaticResource BtnSale}"
                                    Grid.Row="0" Grid.Column="1" Margin="0,0,0,3"
                                    Click="LogoSale_Click"/>
                            <Button Content="ENCADENA" Style="{StaticResource BtnYellow}"
                                    Grid.Row="1" Grid.Column="0" Margin="0,0,3,0"
                                    Click="LogoEncadena_Click"/>
                            <Button Content="P"        Style="{StaticResource BtnPreview}"
                                    Grid.Row="1" Grid.Column="1"
                                    Click="LogoP_Click"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- BOTES -->
                <GroupBox Header="BOTES">
                    <Grid Margin="6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="76"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeceras -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="CANTIDAD"
                                   FontWeight="Bold" FontSize="10"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="FECHA"
                                   FontWeight="Bold" FontSize="10"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>

                        <!-- BONOLOTO -->
                        <RadioButton Grid.Row="1" Grid.Column="0" Content="BONOLOTO"
                                     GroupName="BoteGame" x:Name="RdbBoteBonoloto"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     FontSize="10" IsChecked="True" Margin="0,2"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantBonoloto" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtFechaBoteBonoloto" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- QUINIGOL -->
                        <RadioButton Grid.Row="2" Grid.Column="0" Content="QUINIGOL"
                                     GroupName="BoteGame" x:Name="RdbBoteQuinigol"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantQuinigol" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="TxtFechaBoteQuinigol" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- EUROMILLONES -->
                        <RadioButton Grid.Row="3" Grid.Column="0" Content="EUROMILLONES"
                                     GroupName="BoteGame" x:Name="RdbBoteEuromillones"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantEuromillones" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="3" Grid.Column="2" x:Name="TxtFechaBoteEuromillones" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- LOTERIA -->
                        <RadioButton Grid.Row="4" Grid.Column="0" Content="LOTERIA"
                                     GroupName="BoteGame" x:Name="RdbBoteLoteria"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantLoteria" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="4" Grid.Column="2" x:Name="TxtFechaBoteLoteria" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- PRIMITIVA -->
                        <RadioButton Grid.Row="5" Grid.Column="0" Content="PRIMITIVA"
                                     GroupName="BoteGame" x:Name="RdbBotePrimitiva"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantPrimitiva" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="5" Grid.Column="2" x:Name="TxtFechaBotePrimitiva" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- QUINIELA -->
                        <RadioButton Grid.Row="6" Grid.Column="0" Content="QUINIELA"
                                     GroupName="BoteGame" x:Name="RdbBoteQuiniela"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantQuiniela" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="6" Grid.Column="2" x:Name="TxtFechaBoteQuiniela" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- EL GORDO -->
                        <RadioButton Grid.Row="7" Grid.Column="0" Content="EL GORDO"
                                     GroupName="BoteGame" x:Name="RdbBoteElGordo"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantElGordo" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="7" Grid.Column="2" x:Name="TxtFechaBoteElGordo" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- LOTOTURF -->
                        <RadioButton Grid.Row="8" Grid.Column="0" Content="LOTOTURF"
                                     GroupName="BoteGame" x:Name="RdbBoteLototurf"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="8" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantLototurf" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="8" Grid.Column="2" x:Name="TxtFechaBoteLototurf" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- JOKER -->
                        <RadioButton Grid.Row="9" Grid.Column="0" Content="JOKER"
                                     GroupName="BoteGame" x:Name="RdbBoteJoker"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="9" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantJoker" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="9" Grid.Column="2" x:Name="TxtFechaBoteJoker" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- EURODREAMS -->
                        <RadioButton Grid.Row="10" Grid.Column="0" Content="Eurodreams"
                                     GroupName="BoteGame" x:Name="RdbBoteEurodreams"
                                     Foreground="{StaticResource BrushTextPrimary}" FontSize="10" Margin="0,2"/>
                        <StackPanel Grid.Row="10" Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="TxtCantEurodreams" Margin="3,2" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <TextBox Grid.Row="10" Grid.Column="2" x:Name="TxtFechaBoteEurodreams" Height="26" Padding="1,0" Margin="3,2" FontSize="10"/>

                        <!-- Botones BOTES -->
                        <StackPanel Grid.Row="11" Grid.ColumnSpan="3"
                                    Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="ENTRA"    Style="{StaticResource BtnEntra}"
                                    Margin="0,0,4,0" Click="BoteEntra_Click"/>
                            <Button Content="SALE"     Style="{StaticResource BtnSale}"
                                    Margin="0,0,4,0" Click="BoteSale_Click"/>
                            <Button Content="ENCADENA" Style="{StaticResource BtnYellow}"
                                    Margin="0,0,4,0" Click="BoteEncadena_Click"/>
                            <Button Content="P"        Style="{StaticResource BtnPreview}"
                                    MinWidth="50"      Click="BoteP_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

            </StackPanel>

            <!-- ═══ PANEL CENTRAL: PREMIADOS ════════════════════════ -->
            <GroupBox Header="PREMIADOS" Grid.Column="1">
                <Grid Margin="4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filas de juegos -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeceras -->
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="NUMEROS PREMIADOS"
                                   FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="OTROS"
                                   FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="FECHA"
                                   FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>

                        <!-- BONOLOTO — 6 números + complementario + reintegro -->
                        <RadioButton x:Name="RdbP0" Grid.Row="1" Grid.Column="0"
                                     GroupName="PremiadoGame" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,4,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="BONOLOTO"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="0,2,2,2"/>
                        <CheckBox x:Name="ChkBoteP0" Grid.Row="1" Grid.Column="2"
                                  Content="BOTE" FontSize="10" VerticalAlignment="Center" Margin="0,2,4,2"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Tag="BONOLOTO" Checked="BotePremiado_Checked"/>
                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP0N0" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="1" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP0N1" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="2" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP0N2" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="3" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP0N3" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="4" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP0N4" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="5" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP0N5" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="6" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP0O0" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="7" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP0O1" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="8" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <TextBox x:Name="TxtFechaP0" Grid.Row="1" Grid.Column="5" Margin="0,2,4,2" VerticalAlignment="Center"/>

                        <!-- EUROMILLONES M — 5 números + 2 estrellas -->
                        <RadioButton x:Name="RdbP1" Grid.Row="2" Grid.Column="0"
                                     GroupName="PremiadoGame" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,4,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="EUROMILLONES M"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="0,2,2,2"/>
                        <CheckBox x:Name="ChkBoteP1" Grid.Row="2" Grid.Column="2"
                                  Content="BOTE" FontSize="10" VerticalAlignment="Center" Margin="0,2,4,2"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Tag="EUROMILLONES M" Checked="BotePremiado_Checked"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP1N0" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="1" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP1N1" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="2" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP1N2" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="3" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP1N3" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="4" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP1N4" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="5" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP1O0" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="6" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP1O1" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="7" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <TextBox x:Name="TxtFechaP1" Grid.Row="2" Grid.Column="5" Margin="0,2,4,2" VerticalAlignment="Center"/>

                        <!-- PRIMITIVA — 6 números + complementario + reintegro -->
                        <RadioButton x:Name="RdbP2" Grid.Row="3" Grid.Column="0"
                                     GroupName="PremiadoGame" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,4,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="PRIMITIVA"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="0,2,2,2"/>
                        <CheckBox x:Name="ChkBoteP2" Grid.Row="3" Grid.Column="2"
                                  Content="BOTE" FontSize="10" VerticalAlignment="Center" Margin="0,2,4,2"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Tag="PRIMITIVA" Checked="BotePremiado_Checked"/>
                        <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP2N0" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="1" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP2N1" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="2" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP2N2" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="3" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP2N3" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="4" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP2N4" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="5" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP2N5" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="6" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP2O0" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="7" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP2O1" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="8" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <TextBox x:Name="TxtFechaP2" Grid.Row="3" Grid.Column="5" Margin="0,2,4,2" VerticalAlignment="Center"/>

                        <!-- EL GORDO — 5 números + 1 clave -->
                        <RadioButton x:Name="RdbP3" Grid.Row="4" Grid.Column="0"
                                     GroupName="PremiadoGame" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,4,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="EL GORDO"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="0,2,2,2"/>
                        <CheckBox x:Name="ChkBoteP3" Grid.Row="4" Grid.Column="2"
                                  Content="BOTE" FontSize="10" VerticalAlignment="Center" Margin="0,2,4,2"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Tag="EL GORDO" Checked="BotePremiado_Checked"/>
                        <StackPanel Grid.Row="4" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP3N0" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="1" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP3N1" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="2" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP3N2" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="3" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP3N3" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="4" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP3N4" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="5" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP3O0" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="6" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <TextBox x:Name="TxtFechaP3" Grid.Row="4" Grid.Column="5" Margin="0,2,4,2" VerticalAlignment="Center"/>

                        <!-- LOTOTURF — 7 números -->
                        <RadioButton x:Name="RdbP4" Grid.Row="5" Grid.Column="0"
                                     GroupName="PremiadoGame" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,4,2"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="LOTOTURF"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="0,2,2,2"/>
                        <CheckBox x:Name="ChkBoteP4" Grid.Row="5" Grid.Column="2"
                                  Content="BOTE" FontSize="10" VerticalAlignment="Center" Margin="0,2,4,2"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Tag="LOTOTURF" Checked="BotePremiado_Checked"/>
                        <StackPanel Grid.Row="5" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP4N0" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="1" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP4N1" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="2" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP4N2" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="3" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP4N3" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="4" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP4N4" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="5" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP4N5" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="6" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP4O0" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2"/>
                            <TextBox x:Name="TxtP4O1" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2"/>
                        </StackPanel>
                        <TextBox x:Name="TxtFechaP4" Grid.Row="5" Grid.Column="5" Margin="0,2,4,2" VerticalAlignment="Center"/>

                        <!-- EURODREAMS — 6 números + 1 dream -->
                        <RadioButton x:Name="RdbP5" Grid.Row="6" Grid.Column="0"
                                     GroupName="PremiadoGame" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,4,2"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="EURODREAMS"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="0,2,2,2"/>
                        <CheckBox x:Name="ChkBoteP5" Grid.Row="6" Grid.Column="2"
                                  Content="BOTE" FontSize="10" VerticalAlignment="Center" Margin="0,2,4,2"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Tag="EURODREAMS" Checked="BotePremiado_Checked"/>
                        <StackPanel Grid.Row="6" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP5N0" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="1" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP5N1" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="2" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP5N2" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="3" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP5N3" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="4" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP5N4" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="5" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP5N5" Width="36" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="6" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP5O0" Width="31" Height="31" MaxLength="2" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="7" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <TextBox x:Name="TxtFechaP5" Grid.Row="6" Grid.Column="5" Margin="0,2,4,2" VerticalAlignment="Center"/>

                        <!-- JOKER — 7 dígitos -->
                        <RadioButton x:Name="RdbP6" Grid.Row="7" Grid.Column="0"
                                     GroupName="PremiadoGame" VerticalAlignment="Center"
                                     Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,4,2"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="JOKER"
                                   FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" Margin="0,2,2,2"/>
                        <CheckBox x:Name="ChkBoteP6" Grid.Row="7" Grid.Column="2"
                                  Content="BOTE" FontSize="10" VerticalAlignment="Center" Margin="0,2,4,2"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  Tag="JOKER" Checked="BotePremiado_Checked"/>
                        <StackPanel Grid.Row="7" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtP6N0" Width="36" Height="31" MaxLength="1" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="1" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP6N1" Width="36" Height="31" MaxLength="1" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="2" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP6N2" Width="36" Height="31" MaxLength="1" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="3" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP6N3" Width="36" Height="31" MaxLength="1" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="4" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP6N4" Width="36" Height="31" MaxLength="1" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="5" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP6N5" Width="36" Height="31" MaxLength="1" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="6" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                            <TextBox x:Name="TxtP6N6" Width="36" Height="31" MaxLength="1" HorizontalContentAlignment="Center" Padding="1,0" Margin="0,2,2,2" Tag="7" PreviewKeyDown="NumPremiado_PreviewKeyDown"/>
                        </StackPanel>
                        <TextBox x:Name="TxtFechaP6" Grid.Row="7" Grid.Column="5" Margin="0,2,4,2" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Botones de acción -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6">
                        <Button Content="P"        Style="{StaticResource BtnPreview}"
                                MinWidth="80"  Margin="0,0,6,0" Click="PremiadosP_Click"/>
                        <Button Content="ENTRA"    Style="{StaticResource BtnEntra}"
                                MinWidth="80"  Margin="0,0,6,0" Click="PremiadosEntra_Click"/>
                        <Button Content="SALE"     Style="{StaticResource BtnSale}"
                                MinWidth="80"  Margin="0,0,6,0" Click="PremiadosSale_Click"/>
                        <Button Content="ENCADENA" Style="{StaticResource BtnYellow}"
                                MinWidth="100" Margin="0,0,6,0" Click="PremiadosEncadena_Click"/>
                        <Button Content="ORDENAR"  Style="{StaticResource BtnBlue}"
                                MinWidth="100"             Click="PremiadosOrdenar_Click"/>
                    </StackPanel>

                    <!-- FALDONES APUESTAS -->
                    <GroupBox Header="FALDONES APUESTAS" Grid.Row="2">
                        <StackPanel Orientation="Horizontal" Margin="6,4">
                            <Button Content="ENTRA"    Style="{StaticResource BtnEntra}"
                                    Margin="0,0,4,0" Click="FaldonEntra_Click"/>
                            <Button Content="SALE"     Style="{StaticResource BtnSale}"
                                    Margin="0,0,4,0" Click="FaldonSale_Click"/>
                            <Button Content="CORREGIR" Style="{StaticResource BtnBlue}"
                                    Margin="0,0,16,0" Click="FaldonCorregir_Click"/>
                            <CheckBox x:Name="ChkSeguridad"
                                      Content="Seguridad"
                                      IsChecked="True"
                                      Foreground="{StaticResource BrushTextPrimary}"
                                      VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <CheckBox x:Name="ChkPasarGanador"
                                      Content="Pasar ganador con TAB"
                                      IsChecked="True"
                                      Foreground="{StaticResource BrushTextPrimary}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <!-- ═══ PANEL DERECHO ═══════════════════════════════════ -->
            <StackPanel Grid.Column="2" Width="172" Margin="5,0,0,0">

                <!-- EL MILLÓN / JOKER -->
                <GroupBox Header="EL MILLÓN" Margin="0,0,0,5">
                    <StackPanel Margin="5">
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="El millón martes"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <Button Content="P" Style="{StaticResource BtnPreview}"
                                    Grid.Column="1" MinWidth="44"
                                    Click="MillonP_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fecha" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,4,3"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMillonFecha" Margin="0,0,0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Número" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMillonMartes"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="ENTRA" Style="{StaticResource BtnEntra}"
                                    Grid.Column="0" Margin="0,0,3,0" Click="MillonEntra_Click"/>
                            <Button Content="SALE"  Style="{StaticResource BtnSale}"
                                    Grid.Column="1"                Click="MillonSale_Click"/>
                        </Grid>

                    </StackPanel>
                </GroupBox>

                <!-- EUROMILLONES -->
                <GroupBox Header="EUROMILLONES" Margin="0,0,0,5">
                    <StackPanel Margin="5">
                        <TextBox x:Name="TxtEuromillonesMillon" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="ENTRA MOSCA" Style="{StaticResource BtnEntra}"
                                    Grid.Column="0" Margin="0,0,3,0"
                                    Click="EuroMillonEntra_Click"/>
                            <Button Content="SALE MOSCA"  Style="{StaticResource BtnSale}"
                                    Grid.Column="1"
                                    Click="EuroMillonSale_Click"/>
                        </Grid>
                        <Button Content="P" Style="{StaticResource BtnPreview}"
                                Click="EuroMillonP_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- EURODREAMS -->
                <GroupBox Header="EURODREAMS">
                    <StackPanel Margin="5">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="LUNES"  Style="{StaticResource BtnBlue}"
                                    Grid.Column="0" Margin="0,0,3,0"
                                    Click="EurodreamsLunes_Click"/>
                            <Button Content="JUEVES" Style="{StaticResource BtnBlue}"
                                    Grid.Column="1"
                                    Click="EurodreamsJueves_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="ENTRA" Style="{StaticResource BtnEntra}"
                                    Grid.Column="0" Margin="0,0,3,0"
                                    Click="EurodreamsEntra_Click"/>
                            <Button Content="SALE"  Style="{StaticResource BtnSale}"
                                    Grid.Column="1" Margin="0,0,3,0"
                                    Click="EurodreamsSale_Click"/>
                            <Button Content="P" Style="{StaticResource BtnPreview}"
                                    Grid.Column="2" Click="EurodreamsP_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="PREMIADO" Style="{StaticResource BtnPreview}"
                                    Grid.Column="0" Margin="0,0,3,0"
                                    Click="EurodreamsPremiado_Click"/>
                            <Button Content="PROXIMO"  Style="{StaticResource BtnYellow}"
                                    Grid.Column="1"
                                    Click="EurodreamsProximo_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                <TextBlock Text="Dia" FontSize="10"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtEurodreamsDia" MaxLength="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Mes" FontSize="10"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtEurodreamsMes" MaxLength="2"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </Grid>
</UserControl>
