<UserControl x:Class="LoteriaTwo.Views.LoteriayRotulosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!-- COLUMN 0 — WEB + IMÁGENES + COLAS      -->
        <!-- ═══════════════════════════════════════ -->
        <StackPanel Grid.Column="0" Margin="0,0,3,0">

            <!-- WEB -->
            <GroupBox Header="WEB" Margin="0,0,0,3">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Content="P"     Style="{StaticResource BtnPreview}"
                            Grid.Row="0" Grid.Column="0" Margin="1" Click="WebPreview_Click"/>
                    <Button Content="ENTRA" Style="{StaticResource BtnEntra}"
                            Grid.Row="0" Grid.Column="1" Margin="1" Click="WebEntra_Click"/>
                    <Button Content="SALE"  Style="{StaticResource BtnSale}"
                            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="1" Click="WebSale_Click"/>
                </Grid>
            </GroupBox>

            <!-- IMÁGENES -->
            <GroupBox Header="IMÁGENES">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- P spans rows 0-1 -->
                    <Button Content="P" Style="{StaticResource BtnPreview}"
                            Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                            Margin="0,1,3,1" Click="ImagenesPreview_Click"/>
                    <RadioButton Content="Foto 1" GroupName="Imagenes"
                                 Grid.Row="0" Grid.Column="1"
                                 Margin="1,1,4,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLogoFoto1"
                              Grid.Row="0" Grid.Column="2" Margin="0,1,0,0"/>
                    <RadioButton Content="Foto 2" GroupName="Imagenes"
                                 Grid.Row="1" Grid.Column="1"
                                 Margin="1,0,4,1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLogoFoto2"
                              Grid.Row="1" Grid.Column="2" Margin="0,0,0,1"/>

                    <!-- ENTRA spans rows 2-3 -->
                    <Button Content="ENTRA" Style="{StaticResource BtnEntra}"
                            Grid.Row="2" Grid.Column="0" Grid.RowSpan="2"
                            Margin="0,1,3,1" Click="ImagenesEntra_Click"/>
                    <RadioButton Content="Foto 3" GroupName="Imagenes"
                                 Grid.Row="2" Grid.Column="1"
                                 Margin="1,1,4,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLogoFoto3"
                              Grid.Row="2" Grid.Column="2" Margin="0,1,0,0"/>
                    <RadioButton Content="Foto 4" GroupName="Imagenes"
                                 Grid.Row="3" Grid.Column="1"
                                 Margin="1,0,4,1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLogoFoto4"
                              Grid.Row="3" Grid.Column="2" Margin="0,0,0,1"/>

                    <!-- SALE row 4 -->
                    <Button Content="SALE" Style="{StaticResource BtnSale}"
                            Grid.Row="4" Grid.Column="0"
                            Margin="0,1,3,1" Click="ImagenesSale_Click"/>
                    <RadioButton Content="Foto 5" GroupName="Imagenes"
                                 Grid.Row="4" Grid.Column="1"
                                 Margin="1,1,4,1" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLogoFoto5"
                              Grid.Row="4" Grid.Column="2" Margin="0,1,0,1"/>

                    <!-- F1–F5 rows span all columns -->
                    <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TxtF1" Grid.Row="0" Grid.Column="0" Margin="0,1,2,1"/>
                        <Button  Content="F1"   Grid.Row="0" Grid.Column="1" Margin="0,1"
                                 Style="{StaticResource BtnBlue}" Click="F1_Click"/>

                        <TextBox x:Name="TxtF2" Grid.Row="1" Grid.Column="0" Margin="0,1,2,1"/>
                        <Button  Content="F2"   Grid.Row="1" Grid.Column="1" Margin="0,1"
                                 Style="{StaticResource BtnBlue}" Click="F2_Click"/>

                        <TextBox x:Name="TxtF3" Grid.Row="2" Grid.Column="0" Margin="0,1,2,1"/>
                        <Button  Content="F3"   Grid.Row="2" Grid.Column="1" Margin="0,1"
                                 Style="{StaticResource BtnBlue}" Click="F3_Click"/>

                        <TextBox x:Name="TxtF4" Grid.Row="3" Grid.Column="0" Margin="0,1,2,1"/>
                        <Button  Content="F4"   Grid.Row="3" Grid.Column="1" Margin="0,1"
                                 Style="{StaticResource BtnBlue}" Click="F4_Click"/>

                        <TextBox x:Name="TxtF5" Grid.Row="4" Grid.Column="0" Margin="0,1,2,1"/>
                        <Button  Content="F5"   Grid.Row="4" Grid.Column="1" Margin="0,1"
                                 Style="{StaticResource BtnBlue}" Click="F5_Click"/>
                    </Grid>

                </Grid>
            </GroupBox>

            <!-- COLAS -->
            <GroupBox Header="COLAS" Margin="0,3,0,0">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="CmbLogoColas"
                              Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="1"/>
                    <Button Content="P"           Style="{StaticResource BtnPreview}"
                            Grid.Row="1" Grid.Column="0" Margin="1" Click="ColasPreview_Click"/>
                    <Button Content="ENTRA COLAS" Style="{StaticResource BtnEntra}"
                            Grid.Row="1" Grid.Column="1" Margin="1" Click="ColasEntra_Click"/>
                    <Button Content="SALE COLAS"  Style="{StaticResource BtnSale}"
                            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="1" Click="ColasSale_Click"/>
                </Grid>
            </GroupBox>

        </StackPanel>

        <!-- ═══════════════════════════════════════ -->
        <!-- COLUMN 1 — RÓTULOS                     -->
        <!-- ═══════════════════════════════════════ -->
        <GroupBox Header="RÓTULOS" Grid.Column="1" Margin="0,0,3,0"
                  VerticalAlignment="Top">
            <StackPanel Margin="5">

                <!-- Tipo -->
                <GroupBox Header="Tipo" Margin="0,0,0,5">
                    <StackPanel Margin="4,2">
                        <RadioButton Content="La Suerte"  GroupName="TipoRotulo" Margin="0,1"/>
                        <RadioButton Content="LAE"        GroupName="TipoRotulo" Margin="0,1"/>
                        <RadioButton Content="Caja doble" GroupName="TipoRotulo" Margin="0,1"/>
                    </StackPanel>
                </GroupBox>

                <!-- Column headers -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Primera Línea" FontWeight="Bold" FontSize="10" Grid.Column="0"/>
                    <TextBlock Text="Segunda Línea" FontWeight="Bold" FontSize="10" Grid.Column="1"/>
                </Grid>

                <!-- Presenter quick-fill -->
                <Button Content="Sandra Daviu"   Tag="Sandra Daviu"
                        Style="{StaticResource BtnFlat}" Click="PresenterName_Click"/>
                <Button Content="Blanca Benlloch" Tag="Blanca Benlloch"
                        Style="{StaticResource BtnFlat}" Click="PresenterName_Click"/>
                <Button Content="Lucia Vinaixe"  Tag="Lucia Vinaixe"
                        Style="{StaticResource BtnFlat}" Click="PresenterName_Click"/>

                <!-- Línea 1 -->
                <Grid Margin="0,5,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Línea 1" Grid.Column="0" VerticalAlignment="Center" FontSize="10"/>
                    <TextBox x:Name="TxtLinea1Primera" Grid.Column="1" Margin="0,0,2,0"/>
                    <TextBox x:Name="TxtLinea1Segunda" Grid.Column="2"/>
                </Grid>

                <!-- Línea 2 -->
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Línea 2" Grid.Column="0" VerticalAlignment="Center" FontSize="10"/>
                    <TextBox x:Name="TxtLinea2" Grid.Column="1"/>
                </Grid>

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="ENTRA ROTULO" Style="{StaticResource BtnEntra}"
                            Margin="0,0,3,0" Click="EntrarRotulo_Click"/>
                    <Button Content="SALE ROTULO"  Style="{StaticResource BtnSale}"
                            Margin="0,0,3,0" Click="SaleRotulo_Click"/>
                    <Button Content="P" Style="{StaticResource BtnPreview}"
                            MinWidth="40" Click="PreviewRotulo_Click"/>
                </StackPanel>

            </StackPanel>
        </GroupBox>

        <!-- ═══════════════════════════════════════ -->
        <!-- COLUMN 2 — CIUDADES                    -->
        <!-- ═══════════════════════════════════════ -->
        <GroupBox Header="CIUDADES" Grid.Column="2" VerticalAlignment="Top">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- FECHA -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FECHA" Grid.Column="0" FontWeight="Bold" FontSize="10"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtCiudadesFecha" Grid.Column="1"/>
                </Grid>

                <!-- Radio 1–4 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton Content="1" GroupName="CiudadNum" Margin="0,0,14,0"
                                 Tag="0" IsChecked="True" Checked="MapaSeleccionado_Checked"/>
                    <RadioButton Content="2" GroupName="CiudadNum" Margin="0,0,14,0"
                                 Tag="1" Checked="MapaSeleccionado_Checked"/>
                    <RadioButton Content="3" GroupName="CiudadNum" Margin="0,0,14,0"
                                 Tag="2" Checked="MapaSeleccionado_Checked"/>
                    <RadioButton Content="4" GroupName="CiudadNum"
                                 Tag="3" Checked="MapaSeleccionado_Checked"/>
                </StackPanel>

                <!-- Column headers -->
                <Grid Grid.Row="2" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CIUDADES" Grid.Column="0" FontWeight="Bold" FontSize="10"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="COMUNIDADES" Grid.Column="1" FontWeight="Bold" FontSize="10"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                </Grid>

                <!-- Ciudad/Comunidad rows -->
                <Grid Grid.Row="3" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  x:Name="TxtCiudad1"    Grid.Column="0" Margin="0,0,2,0"/>
                    <ComboBox x:Name="CmbComunidad1" Grid.Column="1"/>
                </Grid>
                <Grid Grid.Row="4" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  x:Name="TxtCiudad2"    Grid.Column="0" Margin="0,0,2,0"/>
                    <ComboBox x:Name="CmbComunidad2" Grid.Column="1"/>
                </Grid>
                <Grid Grid.Row="5" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  x:Name="TxtCiudad3"    Grid.Column="0" Margin="0,0,2,0"/>
                    <ComboBox x:Name="CmbComunidad3" Grid.Column="1"/>
                </Grid>
                <Grid Grid.Row="6" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  x:Name="TxtCiudad4"    Grid.Column="0" Margin="0,0,2,0"/>
                    <ComboBox x:Name="CmbComunidad4" Grid.Column="1"/>
                </Grid>
                <Grid Grid.Row="7" Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox  x:Name="TxtCiudad5"    Grid.Column="0" Margin="0,0,2,0"/>
                    <ComboBox x:Name="CmbComunidad5" Grid.Column="1"/>
                </Grid>

                <!-- LOGO + TEXTO section -->
                <Grid Grid.Row="9" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LOGO column -->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="LOGO" FontWeight="Bold" FontSize="10" Margin="0,0,0,2"/>
                        <ListBox x:Name="LstLogos" Height="95"
                                 SelectionChanged="LstLogos_SelectionChanged">
                            <ListBoxItem Content=""/>
                            <ListBoxItem Content="Bonoloto"/>
                            <ListBoxItem Content="Primitiva"/>
                            <ListBoxItem Content="El Gordo"/>
                            <ListBoxItem Content="Euromillones"/>
                            <ListBoxItem Content="EuromillonesMillon"/>
                            <ListBoxItem Content="Eurodreams"/>
                            <ListBoxItem Content="LotoTurf"/>
                            <ListBoxItem Content="Quiniela"/>
                            <ListBoxItem Content="Quinigol"/>
                            <ListBoxItem Content="LoteriaNacional"/>
                            <ListBoxItem Content="ApuestaHipica"/>
                            <ListBoxItem Content="Joker"/>
                            <ListBoxItem Content="ElMillon"/>
                            <ListBoxItem Content="Deporte"/>
                            <ListBoxItem Content="Cultura"/>
                            <ListBoxItem Content="Sociedad"/>
                            <ListBoxItem Content="GenericoLAE"/>
                            <ListBoxItem Content="ProgLaSuerte"/>
                            <ListBoxItem Content="Elige8"/>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Button Content="P"     Style="{StaticResource BtnPreview}"
                                    MinWidth="32" Margin="0,0,2,0" Click="LogoPreview_Click"/>
                            <Button Content="ENTRA" Style="{StaticResource BtnEntra}"
                                    Margin="0,0,2,0" Click="LogoEntra_Click"/>
                            <Button Content="SALE"  Style="{StaticResource BtnSale}"
                                    Click="LogoSale_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- TEXTO column -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="TEXTO 1" FontWeight="Bold" FontSize="10"
                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTexto1" Margin="0,0,0,8"/>
                        <TextBlock Text="TEXTO 2" FontWeight="Bold" FontSize="10"
                                   Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtTexto2"/>
                    </StackPanel>

                </Grid>

            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
