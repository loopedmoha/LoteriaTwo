<UserControl x:Class="LoteriaTwo.Views.PlaylistPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Background="{StaticResource BrushSurface}">

        <!-- ── Cabecera: selector + guardar/cargar/limpiar ── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,0,0,1"
                Padding="8,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Guardar" Style="{StaticResource BtnBlue}"
                            FontSize="10" Padding="8,3" Margin="0,0,4,0"
                            Click="Guardar_Click"/>
                    <Button Content="Cargar" Style="{StaticResource BtnBlue}"
                            FontSize="10" Padding="8,3" Margin="0,0,4,0"
                            Click="Cargar_Click"/>
                    <Button Content="Limpiar" Style="{StaticResource BtnReset}"
                            FontSize="10" Padding="8,3"
                            Click="LimpiarPlaylist_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PLAYLIST" FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RbPl1" Content="1" GroupName="PLSel" Tag="0"
                                 IsChecked="True" VerticalAlignment="Center"
                                 Margin="0,0,10,0" Checked="PlSel_Checked"/>
                    <RadioButton x:Name="RbPl2" Content="2" GroupName="PLSel" Tag="1"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Checked="PlSel_Checked"/>
                    <RadioButton x:Name="RbPl3" Content="3" GroupName="PLSel" Tag="2"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Checked="PlSel_Checked"/>
                    <RadioButton x:Name="RbPl4" Content="4" GroupName="PLSel" Tag="3"
                                 VerticalAlignment="Center"
                                 Checked="PlSel_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Pie: SALE + SIGUIENTE (siempre visibles) ── -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,1,0,0"
                Padding="8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="SALE" Style="{StaticResource BtnSale}"
                        Grid.Column="0" Padding="20,10" FontSize="12" FontWeight="Bold"
                        Margin="0,0,8,0" Click="ElemSale_Click"/>
                <Button Content="▶   SIGUIENTE" Style="{StaticResource BtnEntra}"
                        Grid.Column="1" FontSize="14" FontWeight="Bold" Padding="0,10"
                        Click="ElemSig_Click"/>
            </Grid>
        </Border>

        <!-- ── Cuerpo: dos columnas (logos fijo | elementos flex) ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LOGOS ── -->
            <DockPanel Grid.Column="0" Margin="8,8,6,8" LastChildFill="True">

                <TextBlock x:Name="TxtHeaderLogos" DockPanel.Dock="Top"
                           Text="LOGOS (0)" FontWeight="Bold" FontSize="10"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,0,0,5"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="▲" Style="{StaticResource BtnFlat}"
                            Width="26" Height="24" FontSize="11" Padding="0"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,2,0" Click="LogoUp_Click"/>
                    <Button Content="▼" Style="{StaticResource BtnFlat}"
                            Width="26" Height="24" FontSize="11" Padding="0"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,2,0" Click="LogoDown_Click"/>
                    <Button Content="✕" Style="{StaticResource BtnReset}"
                            Width="26" Height="24" FontSize="11" Padding="0"
                            HorizontalContentAlignment="Center"
                            Click="LogoEliminar_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Entra" Style="{StaticResource BtnEntra}"
                            FontSize="10" Padding="6,4" Margin="0,0,3,0"
                            Click="EntraLogo_Click"/>
                    <Button Content="Sale" Style="{StaticResource BtnSale}"
                            FontSize="10" Padding="6,4"
                            Click="SaleLogo_Click"/>
                </StackPanel>

                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="LstLogos"
                             BorderThickness="0" Background="Transparent"
                             FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Nombre}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="5,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Separador vertical -->
            <Border Grid.Column="1" Width="1"
                    Background="{StaticResource BrushBorder}"
                    Margin="0,8,0,8"/>

            <!-- ── ELEMENTOS ── -->
            <DockPanel Grid.Column="2" Margin="6,8,8,8" LastChildFill="True">

                <TextBlock x:Name="TxtHeaderElementos" DockPanel.Dock="Top"
                           Text="ELEMENTOS (0)" FontWeight="Bold" FontSize="10"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,0,0,5"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="▲" Style="{StaticResource BtnFlat}"
                            Width="26" Height="24" FontSize="11" Padding="0"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,2,0" Click="ElemUp_Click"/>
                    <Button Content="▼" Style="{StaticResource BtnFlat}"
                            Width="26" Height="24" FontSize="11" Padding="0"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,2,0" Click="ElemDown_Click"/>
                    <Button Content="✕" Style="{StaticResource BtnReset}"
                            Width="26" Height="24" FontSize="11" Padding="0"
                            HorizontalContentAlignment="Center"
                            Click="ElemEliminar_Click"/>
                </StackPanel>

                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="LstElementos"
                             BorderThickness="0" Background="Transparent"
                             FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LstElementos_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nombre}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Nombre}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="5,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>

    </DockPanel>
</UserControl>
