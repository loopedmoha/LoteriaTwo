<Window x:Class="LoteriaTwo.Views.DebugElementosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug — Repositorios"
        Width="960" Height="580"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">

    <TabControl Margin="8">

        <!-- ══ PESTAÑA ELEMENTOS ══════════════════════════════════════ -->
        <TabItem Header="Elementos">
            <Grid Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- Lista -->
                <DataGrid x:Name="DgElementos"
                          Grid.Row="0" Grid.Column="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Margin="0,0,8,0"
                          SelectionChanged="DgElementos_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo}"
                                            Width="155"/>
                        <DataGridTextColumn Header="Creado"
                                            Binding="{Binding CreadoEn, StringFormat=HH:mm:ss}"
                                            Width="65"/>
                        <DataGridTextColumn Header="Logo"
                                            Binding="{Binding NombreLogo}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Datos"
                                            Binding="{Binding Resumen}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Detalle -->
                <Border Grid.Row="0" Grid.Column="1"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="DETALLE"
                                   FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDetalle"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 FontFamily="Consolas"
                                 FontSize="11"/>
                    </DockPanel>
                </Border>

                <!-- Acciones -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtConteo"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11" Margin="0,0,16,0"/>
                    <Button Content="Eliminar seleccionado"
                            Style="{StaticResource BtnSale}"
                            MinWidth="160" Margin="0,0,6,0"
                            Click="Eliminar_Click"/>
                    <Button Content="Limpiar todo"
                            Style="{StaticResource BtnReset}"
                            MinWidth="100" Margin="0,0,6,0"
                            Click="LimpiarTodo_Click"/>
                    <Button Content="Refrescar"
                            Style="{StaticResource BtnBlue}"
                            MinWidth="90"
                            Click="Refrescar_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ══ PESTAÑA LOGOS ══════════════════════════════════════════ -->
        <TabItem Header="Logos">
            <Grid Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="DgLogos"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding Id}"
                                            Width="280"/>
                        <DataGridTextColumn Header="Creado"
                                            Binding="{Binding CreadoEn, StringFormat=HH:mm:ss}"
                                            Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Acciones -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtConteoLogos"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11" Margin="0,0,16,0"/>
                    <Button Content="Eliminar seleccionado"
                            Style="{StaticResource BtnSale}"
                            MinWidth="160" Margin="0,0,6,0"
                            Click="EliminarLogo_Click"/>
                    <Button Content="Limpiar todo"
                            Style="{StaticResource BtnReset}"
                            MinWidth="100" Margin="0,0,6,0"
                            Click="LimpiarTodoLogos_Click"/>
                    <Button Content="Refrescar"
                            Style="{StaticResource BtnBlue}"
                            MinWidth="90"
                            Click="RefrescarLogos_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>


        <!-- ══ PESTAÑA LOG ════════════════════════════════════════════ -->
        <TabItem Header="Log">
            <Grid Margin="0,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Ruta del archivo -->
                <TextBlock x:Name="TxtRutaLog"
                           Grid.Row="0"
                           FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,0,0,6"
                           TextTrimming="CharacterEllipsis"/>

                <DataGrid x:Name="DgLog"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowStyle="{StaticResource LogRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora"
                                            Binding="{Binding Hora}"
                                            Width="85"/>
                        <DataGridTextColumn Header="Nivel"
                                            Binding="{Binding Nivel}"
                                            Width="80"/>
                        <DataGridTextColumn Header="Fuente"
                                            Binding="{Binding Fuente}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Mensaje"
                                            Binding="{Binding Mensaje}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Acciones -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtConteoLog"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11" Margin="0,0,16,0"/>
                    <Button Content="Limpiar log"
                            Style="{StaticResource BtnReset}"
                            MinWidth="100" Margin="0,0,6,0"
                            Click="LimpiarLog_Click"/>
                    <Button Content="Refrescar"
                            Style="{StaticResource BtnBlue}"
                            MinWidth="90"
                            Click="RefrescarLog_Click"/>
                </StackPanel>

            </Grid>
        </TabItem>

    </TabControl>
</Window>
