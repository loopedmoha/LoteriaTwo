<Window x:Class="LoteriaTwo.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Width="420" Height="210"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True">

    <Border Background="White" CornerRadius="12"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#111827" ShadowDepth="0" BlurRadius="24" Opacity="0.18"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,30">

            <TextBlock Text="LOTERÍA DOS"
                       FontFamily="Segoe UI" FontSize="28" FontWeight="Bold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Sistema de emisión en directo"
                       FontFamily="Segoe UI" FontSize="11"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock x:Name="TxtStatus"
                       Text="Conectando con Brainstorm..."
                       FontFamily="Segoe UI" FontSize="13"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
