<Window x:Class="LoteriaTwo.Views.ModoSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Width="540" Height="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" Topmost="True">

    <Border Background="White" CornerRadius="12"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#111827" ShadowDepth="0" BlurRadius="24" Opacity="0.18"/>
        </Border.Effect>

        <StackPanel Margin="36,28,36,28">

            <TextBlock Text="SELECCIÓN DE MODO"
                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Elige el estudio de emisión"
                       FontFamily="Segoe UI" FontSize="12"
                       Foreground="#9CA3AF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Prado -->
                <Button Grid.Column="0" Height="110"
                        Style="{StaticResource BtnBlue}"
                        Click="Prado_Click"
                        Padding="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ESTUDIO 3"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="White" Opacity="0.75"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="PRADO"
                                   FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="1 conexión IPF"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="White" Opacity="0.75"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Torre -->
                <Button Grid.Column="2" Height="110"
                        Style="{StaticResource BtnEntra}"
                        Click="Torre_Click"
                        Padding="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ESTUDIO B3"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="White" Opacity="0.75"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="TORRE"
                                   FontFamily="Segoe UI" FontSize="26" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="2 conexiones IPF"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="White" Opacity="0.75"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </StackPanel>
    </Border>
</Window>
