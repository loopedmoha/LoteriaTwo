<Window x:Class="LoteriaTwo.Views.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoteriaTwo.Views"
        Title="Playlist"
        Height="650" Width="380"
        MinHeight="400" MinWidth="330"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Playlist">
                <MenuItem Header="Guardar playlist"        Click="GuardarPlaylist_Click"/>
                <MenuItem Header="Cargar playlist"         Click="CargarPlaylist_Click"/>
                <Separator/>
                <MenuItem Header="Limpiar playlist activa" Click="LimpiarPlaylist_Click"/>
            </MenuItem>
        </Menu>
        <views:PlaylistPanel x:Name="ThePanel"/>
    </DockPanel>
</Window>
