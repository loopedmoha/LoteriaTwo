<Window x:Class="LoteriaTwo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoteriaTwo.Views"
        Title="LoteriaTwo" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- ── Menu bar ───────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File"/>
            <MenuItem Header="Configuracion"/>
        </Menu>

        <!-- ── GENERAL bar (bottom) ───────────────────── -->
        <GroupBox DockPanel.Dock="Bottom" Header="GENERAL" Margin="5,3,5,5">
            <Grid Margin="5,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SALE ULTIMO -->
                <Button Content="SALE ULTIMO" Style="{StaticResource BtnSale}"
                        Grid.Column="0" MinWidth="120" Click="SaleUltimo_Click"/>

                <!-- Center: LIMPIAR + GUARDAR + RECONECTAR -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="LIMPIAR FORMULARIO" Style="{StaticResource BtnBlue}"
                                Margin="0,0,5,0" Click="LimpiarFormulario_Click"/>
                        <Button Content="GUARDAR" Style="{StaticResource BtnBlue}"
                                MinWidth="90" Click="Guardar_Click"/>
                    </StackPanel>
                    <Button Content="RECONECTAR CAMARAS" Style="{StaticResource BtnBlue}"
                            Click="ReconectarCamaras_Click"/>
                </StackPanel>

                <!-- FONDO -->
                <GroupBox Header="FONDO" Grid.Column="3" Margin="12,0" VerticalAlignment="Center">
                    <StackPanel Margin="6,4">
                        <Button Content="ENTRA FONDO" Style="{StaticResource BtnEntra}"
                                Margin="0,0,0,3" Click="EntrarFondo_Click"/>
                        <Button Content="SALE FONDO"  Style="{StaticResource BtnSale}"
                                Click="SaleFondo_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- ABRIR PLAYLIST + SINCRONIZAR -->
                <StackPanel Grid.Column="4" Margin="12,0" VerticalAlignment="Center">
                    <Button Content="ABRIR PLAYLIST" Style="{StaticResource BtnPreview}"
                            Margin="0,0,0,8" Click="AbrirPlaylist_Click"/>
                    <CheckBox x:Name="ChkSincronizarLogos"
                              Content="SINCRONIZAR LOGOS CON ENTRA PREMIOS" FontSize="10"/>
                </StackPanel>

                <!-- RESET -->
                <Button Content="RESET" Style="{StaticResource BtnReset}"
                        Grid.Column="5" MinWidth="60" MinHeight="60"
                        Click="Reset_Click"/>

            </Grid>
        </GroupBox>

        <!-- ── Tab control ────────────────────────────── -->
        <TabControl Margin="5,3,5,0">
            <TabItem Header="LOTERÍA y RÓTULOS">
                <views:LoteriayRotulosView/>
            </TabItem>
            <TabItem Header="DÉCIMOS">
                <TextBlock Text="Pestaña DÉCIMOS — próximamente"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="Gray"/>
            </TabItem>
            <TabItem Header="QUINIELA">
                <TextBlock Text="Pestaña QUINIELA — próximamente"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="Gray"/>
            </TabItem>
            <TabItem Header="SORTEOS y BOTES">
                <TextBlock Text="Pestaña SORTEOS y BOTES — próximamente"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="Gray"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
