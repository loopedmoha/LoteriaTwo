<Window x:Class="LoteriaTwo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoteriaTwo.Views"
        Title="Control de Loterías" Height="720" Width="1280"
        MinWidth="1000" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI">
    <DockPanel>

        <!-- ── Menu bar ───────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Archivo"/>
            <MenuItem Header="Configuración">
                <MenuItem Header="Reconectar a IPF" Click="ReconectarIPF_Click"/>
            </MenuItem>
            <MenuItem Header="Ayuda">
                <MenuItem Header="Calendario de Soporte" Click="CalendarioSoporte_Click"/>
            </MenuItem>
            <MenuItem Header="Playlist">
                <MenuItem Header="Guardar playlist" Click="GuardarPlaylist_Click"/>
                <MenuItem Header="Cargar playlist"  Click="CargarPlaylist_Click"/>
                <Separator/>
                <MenuItem Header="Limpiar playlist activa" Click="LimpiarPlaylist_Click"/>
            </MenuItem>
            <MenuItem Header="Debug">
                <MenuItem Header="Repositorio de Elementos" Click="DebugElementos_Click"/>
            </MenuItem>
        </Menu>

        <!-- ── Barra inferior GENERAL ──────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SALE ULTIMO -->
                <Button Content="SALE ÚLTIMO" Style="{StaticResource BtnSale}"
                        Grid.Column="0" MinWidth="130"
                        Click="SaleUltimo_Click"/>

                <!-- Indicadores de conexión (construidos en código) -->
                <StackPanel x:Name="PnlConexion" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- LIMPIAR + GUARDAR -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="LIMPIAR" Style="{StaticResource BtnBlue}"
                            Margin="0,0,6,0" Click="LimpiarFormulario_Click"/>
                    <Button Content="GUARDAR" Style="{StaticResource BtnBlue}"
                            MinWidth="90" Click="Guardar_Click"/>
                </StackPanel>

                <!-- FONDO -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="FONDO" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="ENTRA" Style="{StaticResource BtnEntra}"
                            Margin="0,0,6,0" Click="EntrarFondo_Click"/>
                    <Button Content="SALE"  Style="{StaticResource BtnSale}"
                            Click="SaleFondo_Click"/>
                </StackPanel>

                <!-- ABRIR PLAYLIST -->
                <Button Content="ABRIR PLAYLIST" Style="{StaticResource BtnBlue}"
                        Grid.Column="4" Margin="0,0,8,0"
                        Click="AbrirPlaylist_Click"/>

                <!-- RESET -->
                <Button Content="RESET" Style="{StaticResource BtnReset}"
                        Grid.Column="5" MinWidth="52" MinHeight="34"
                        Click="Reset_Click"/>
            </Grid>
        </Border>

        <!-- ── Contenido principal ──────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="145"/>   <!-- Sidebar -->
                <ColumnDefinition Width="*"/>                             <!-- Contenido -->
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar nav ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Botón toggle siempre visible -->
                    <Button x:Name="BtnToggleSidebar"
                            DockPanel.Dock="Top"
                            Content="◀"
                            Style="{StaticResource BtnFlat}"
                            HorizontalAlignment="Right"
                            Width="28" Height="22"
                            FontSize="10" Padding="0"
                            Margin="2,4,2,0"
                            Click="ToggleSidebar_Click"/>

                    <!-- Contenido colapsable -->
                    <StackPanel x:Name="SidebarContent">
                        <!-- Logo / título -->
                        <StackPanel Margin="10,6,10,8">
                            <TextBlock Text="CONTROL DE" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="LOTERÍAS" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"/>
                            <TextBlock Text="Control IPF" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Separador -->
                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="16,0,16,10"/>

                        <!-- Items de navegación -->
                        <RadioButton x:Name="NavLoteria"
                                     Content="Lotería y Rótulos"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     IsChecked="True"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDecimos"
                                     Content="Décimos"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavQuiniela"
                                     Content="Quiniela"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSorteos"
                                     Content="Sorteos y Botes"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavControlMundo"
                                     Content="Control de mundo"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Área de contenido ── -->
            <Grid Grid.Column="1" Margin="0">
                <views:LoteriayRotulosView x:Name="ViewLoteria"/>
                <views:DecimosView         x:Name="ViewDecimos"      Visibility="Collapsed"/>
                <views:QuinielaView        x:Name="ViewQuiniela"     Visibility="Collapsed"/>
                <views:SorteosBotesView    x:Name="ViewSorteos"      Visibility="Collapsed"/>
                <views:ControlMundoView    x:Name="ViewControlMundo" Visibility="Collapsed"/>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
