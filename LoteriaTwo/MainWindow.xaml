<Window x:Class="LoteriaTwo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoteriaTwo.Views"
        Title="LoteriaTwo" Height="800" Width="1440"
        MinWidth="1100" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI">
    <DockPanel>

        <!-- ── Menu bar ───────────────────────────────── -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Archivo"/>
            <MenuItem Header="Configuración">
                <MenuItem Header="Reconectar a IPF" Click="ReconectarIPF_Click"/>
            </MenuItem>
            <MenuItem Header="Debug">
                <MenuItem Header="Repositorio de Elementos" Click="DebugElementos_Click"/>
            </MenuItem>
        </Menu>

        <!-- ── Barra inferior GENERAL ──────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SALE ULTIMO -->
                <Button Content="SALE ÚLTIMO" Style="{StaticResource BtnSale}"
                        Grid.Column="0" MinWidth="130"
                        Click="SaleUltimo_Click"/>

                <!-- Indicador de conexión -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse x:Name="EllipseConexion" Width="10" Height="10"
                             Fill="#DC2626" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtConexion" Text="Sin conexión IPF"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- LIMPIAR + GUARDAR -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="LIMPIAR" Style="{StaticResource BtnBlue}"
                            Margin="0,0,6,0" Click="LimpiarFormulario_Click"/>
                    <Button Content="GUARDAR" Style="{StaticResource BtnBlue}"
                            MinWidth="90" Click="Guardar_Click"/>
                </StackPanel>

                <!-- FONDO -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="FONDO" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="ENTRA" Style="{StaticResource BtnEntra}"
                            Margin="0,0,6,0" Click="EntrarFondo_Click"/>
                    <Button Content="SALE"  Style="{StaticResource BtnSale}"
                            Click="SaleFondo_Click"/>
                </StackPanel>

                <!-- ABRIR PLAYLIST + SYNC -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="ABRIR PLAYLIST" Style="{StaticResource BtnPreview}"
                            Margin="0,0,0,4" Click="AbrirPlaylist_Click"/>
                    <CheckBox x:Name="ChkSincronizarLogos"
                              Content="Sincronizar logos con Entra premios"
                              FontSize="10"/>
                </StackPanel>

                <!-- RESET -->
                <Button Content="RESET" Style="{StaticResource BtnReset}"
                        Grid.Column="5" MinWidth="64" MinHeight="52"
                        Click="Reset_Click"/>
            </Grid>
        </Border>

        <!-- ── Contenido principal ──────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185"/>   <!-- Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Contenido -->
                <ColumnDefinition Width="370"/>   <!-- Playlist -->
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar nav ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo / título -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                        <TextBlock Text="LOTERÍAS" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock Text="Control IPF" FontSize="11"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Separador -->
                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{StaticResource BrushBorder}"
                            Margin="16,0,16,10"/>

                    <!-- Items de navegación -->
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavLoteria"
                                     Content="Lotería y Rótulos"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     IsChecked="True"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDecimos"
                                     Content="Décimos"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavQuiniela"
                                     Content="Quiniela"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSorteos"
                                     Content="Sorteos y Botes"
                                     Style="{StaticResource NavBtn}"
                                     GroupName="MainNav"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Área de contenido ── -->
            <Grid Grid.Column="1" Margin="0">
                <views:LoteriayRotulosView x:Name="ViewLoteria"/>
                <views:DecimosView         x:Name="ViewDecimos"  Visibility="Collapsed"/>
                <views:QuinielaView        x:Name="ViewQuiniela" Visibility="Collapsed"/>
                <views:SorteosBotesView    x:Name="ViewSorteos"  Visibility="Collapsed"/>
            </Grid>

            <!-- ── Panel playlist ── -->
            <views:PlaylistPanel Grid.Column="2"/>
        </Grid>

    </DockPanel>
</Window>
